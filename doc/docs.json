{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AgentSDK.nvim",
  "colors": {
    "primary": "#439240",
    "light": "#88C649",
    "dark": "#439240"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/images/logo.png",
    "dark": "/images/logo.png"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/olimorris/agent-sdk.nvim"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/olimorris/agent-sdk.nvim"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "concepts",
          "transports",
          "installation"
        ]
      },
      {
        "group": "Configure",
        "pages": [
          "configure/adapters",
          "configure/providers"
        ]
      },
      {
        "group": "Build a plugin",
        "pages": [
          "build/quickstart",
          "build/testing",
          "build/integrating"
        ]
      },
      {
        "group": "Walkthroughs",
        "pages": [
          "walkthroughs/chat-plugin",
          "walkthroughs/reply"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/api",
          "reference/adapters",
          "reference/credentials",
          "reference/logging",
          "reference/sessions",
          "reference/tool-calls",
          "reference/permissions",
          "reference/test-adapter"
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/configure/acp", "destination": "/configure/providers#other-acp-agents" },
    { "source": "/configure/anthropic", "destination": "/configure/providers#anthropic" },
    { "source": "/configure/claude-code", "destination": "/configure/providers#claude-code" },
    { "source": "/configure/openai", "destination": "/configure/providers#openai" },
    {
      "source": "/build/errors",
      "destination": "/reference/sessions#failed-prompts"
    },
    {
      "source": "/build/sessions",
      "destination": "/reference/sessions"
    },
    {
      "source": "/build/tool-calls",
      "destination": "/reference/tool-calls"
    },
    {
      "source": "/build/permissions",
      "destination": "/reference/permissions"
    },
    {
      "source": "/reference/http-and-acp",
      "destination": "/transports"
    },
    {
      "source": "/walkthroughs/http-reply",
      "destination": "/walkthroughs/reply"
    },
    {
      "source": "/walkthroughs/agent-reply",
      "destination": "/walkthroughs/reply"
    }
  ]
}
